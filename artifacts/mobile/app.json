{
  "expo": {
    "name": "empiri",
    "slug": "empiri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "empiri",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Empiri uses your microphone so you can talk to your companion by voice.",
        "NSMotionUsageDescription": "With Senses turned on, Empiri notices gentle motion like a playful shake while the app is open."
      },
      "bundleIdentifier": "com.empiri.app"
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.empiri.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0C"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Empiri uses your microphone so you can talk to your companion by voice."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A855F7"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "With Senses turned on, Empiri notices gentle motion like a playful shake while the app is open."
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
