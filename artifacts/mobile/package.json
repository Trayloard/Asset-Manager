  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && node scripts/dev.js",
    "build": "node scripts/build.js",
    "build:web": "expo export --platform web --output-dir web-build",
    "check:ios-manifest": "node scripts/validate-ios-manifest.js",
    "serve": "node server/serve.js",
    "check:expo": "expo install --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
